#!/bin/sh
set -e

# 1. Auto-sync components to registry and rebuild registry.json
node packages/registry/scripts/build-registry.js

# 2. Ensure registry and web are in 100% parity and staged
if ! git diff --quiet packages/registry/src/components registry.json; then
  echo ""
  echo "🔄 Auto-synced packages/registry from apps/web to maintain 100% parity."
  echo "👉 Please stage the synced files: git add packages/registry registry.json"
  echo "   Then re-run your commit."
  echo ""
  exit 1
fi

# 3. Quality & integrity gates
npm run typecheck
npm run check:imports
npm test
