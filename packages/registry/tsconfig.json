{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/ui/*": ["./src/components/*"],
      "@/lib/utils": ["./src/lib/utils"]
    }
  },
  "include": ["src/**/*"]
}
